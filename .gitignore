# =============================================================================
# .gitignore — fake-news-jev
# =============================================================================

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Build / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST
wheels/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# --- Data + model artefacts (keep .gitkeep files for the directory layout) -
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
models/*
!models/.gitkeep
results/*
!results/.gitkeep

# --- Secrets / local config -------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# --- Logs -------------------------------------------------------------------
*.log
logs/
api/logs/
ui/logs/

# --- Test / lint caches -----------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.cache

# --- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDEs / OS --------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker / compose local state ------------------------------------------
.docker/
